{
  "redirects": [
    {
      "source": "/maintenance.html",
      "destination": "/maintenance.html",
      "permanent": false
    },
    {
      "source": "/resources/(.*)",
      "destination": "/resources/$1",
      "permanent": false
    },
    {
      "source": "/favicon.ico",
      "destination": "/favicon.ico",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "destination": "/maintenance.html",
      "permanent": false
    }
  ]
}
